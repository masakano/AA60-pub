//
//
//
vert:
uniform vec3 u_light_position;
uniform mat4 u_viewscreen;
uniform mat4 u_worldview;
uniform mat4 u_nodeworld;

in vec4 a_position;
out vec3 f_lightdir;
out vec4 vertTexCoord;
void main()                                                                        
{                                                                                      
       gl_Position = u_nodeworld*a_position;
       f_lightdir = u_light_position - gl_Position.xyz;
       gl_Position = u_viewscreen * u_worldview * gl_Position;
       vertTexCoord = gl_Position;
}                                                                                      

frag:
uniform sampler2DRect u_lightmap;
uniform vec3 u_normal;
in vec3 f_lightdir;
in vec4 vertTexCoord;
out vec3 fragColor;
const int n = 5;
const int ns = (n*n);
const float blur = 0.15/n;
void main()                                                                        
{                                                                                      
       float d = dot(u_normal, normalize(f_lightdir));
       float intensity = 0.5 + pow(1.4*d, 2.0);
       vec3 color = vec3(0.0, 0.0, 0.0);
       int n = 2;
       float pct = 0.5/vertTexCoord.w;
       for(int y=-n; y!=(n+1); ++y)                                                    
       for(int x=-n; x!=(n+1); ++x)                                                    
       {                                                                               
               vec2 coord = vertTexCoord.xy;
               coord += vec2(blur*x, blur*y);
               coord *= pct;
               coord += vec2(0.5, 0.5);
               coord *= textureSize(u_lightmap);
               color += texture(u_lightmap, coord).rgb/ns;
       }                                                                               
       fragColor = color*intensity;
       //fragColor = vec3(0,0,1);
}                                                                                      

