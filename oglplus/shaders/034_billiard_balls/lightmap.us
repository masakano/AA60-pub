//
//
//
vert:
uniform mat4 u_nodescreen;                                                          
in vec4 a_position;                                                                      
out vec3 f_position;                                                                 
void main()                                                                        
{
	f_position = a_position.xyz;                                                    
	gl_Position = u_nodescreen * a_position;                                       
}                                                                                      

frag:
#define def_ball_count 15
uniform vec3 u_light_position;                                                            
uniform vec4 u_ball_positions[def_ball_count];

in vec3 f_position;                                                                  
out vec4 frag_color;                                                                    
void main()                                                                        
{                                                                                      
	float d_max = 0.0;                                                              
	vec3 l = u_light_position;                                                         
	vec3 r = normalize(f_position - u_light_position);
	   
	for(int i=0; i!= def_ball_count; ++i) {                                                                               
		vec3 s = u_ball_positions[i].xyz;                                          
		float a = dot(r, r);                                                    
		float b = 2*dot(l-s, r);                                                
		float c = dot(l-s, l-s)-1.0;                                            
		float d = b*b - 4*a*c;                                                  
		if(d_max < d) d_max = d;                                                
	}                                                                               
	float lt = exp(-d_max*0.8);                                                     
	frag_color = vec4(lt, lt, lt, 1.0);                                              
}                                                                                      
