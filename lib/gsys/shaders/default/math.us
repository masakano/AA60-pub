#pragma once

#ifndef M_PI
#define M_PI 3.1415926535897932384626433832795
#endif

common:

#ifdef def_use_quat
vec4 quat_conj(const vec4 q)
{
	return vec4(-q.x, -q.y, -q.z, q.w);
}

vec4 quat_mul(const vec4 q0, const vec4 q1)
{
	const vec3 p0 = vec3(q0);
	const vec3 p1 = vec3(q1);
	
	const vec3 p2 = p0 * q1.w + p1 * q0.w + cross(p0, p1);
	const float r2 = q0.w * q1.w - dot(p0, p1);
	return vec4(p2, r2);
}

vec3 quat_rot(const vec4 q0, const vec3 p1)
{
	const vec4 q1 = vec4(p1, 0);
	return vec3(quat_mul(q0, quat_mul(q1, quat_conj(q0))));
}

vec3 quat_rot_trans(const vec4 q0, const vec3 t0, const vec3 p1)
{
	return quat_rot(q0, p1) + t0;
}
#endif

#ifdef def_use_rgb_hsv
// https://imagingsolution.net/imaging/hue-saturation-brightness-formula/
// All components are in the range [0…1], including hue.
vec3 rgb2hsv(vec3 c)
{
    vec4 K = vec4(0.0, -1.0 / 3.0, 2.0 / 3.0, -1.0);
    vec4 p = mix(vec4(c.bg, K.wz), vec4(c.gb, K.xy), step(c.b, c.g));
    vec4 q = mix(vec4(p.xyw, c.r), vec4(c.r, p.yzx), step(p.x, c.r));

    float d = q.x - min(q.w, q.y);
    float e = 1.0e-10;
    return vec3(abs(q.z + (q.w - q.y) / (6.0 * d + e)), d / (q.x + e), q.x);
}

// All components are in the range [0…1], including hue.
vec3 hsv2rgb(vec3 c)
{
    vec4 K = vec4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0);
    vec3 p = abs(fract(c.xxx + K.xyz) * 6.0 - K.www);
    return c.z * mix(K.xxx, clamp(p - K.xxx, 0.0, 1.0), c.y);
}
#endif

#ifdef def_use_projected_radius
float projected_radius(const mat4 projection, float projected_position_w, float radius)
{
	float dx = length(projection[0]);
	float dy = length(projection[1]);
	float dz = length(projection[2]);
	return max(max(dx, dy), dz) * radius / projected_position_w;
}
#endif

#ifdef def_use_pcg_next
uint pcg_next(inout uint state)
{
    state = state * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

float pcg_frand(inout uint state)
{
    return float(pcg_next(state)) * (1.0 / 4294967296.0);
}
#endif

common: // resume





