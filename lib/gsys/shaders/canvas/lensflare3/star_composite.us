//
//
//
#include <canvas/vert.us>

vert:
void main() { canvas_main(); }

frag:
in vec2 f_texcoord;
layout (location = 0) out vec4 final_color0;

uniform sampler2D u_color0;
uniform sampler2D u_color1;
uniform sampler2D u_color2;
uniform sampler2D u_color3;

void main()
{
	vec4 color1 = max(textureLod(u_color0, f_texcoord, 0), textureLod(u_color1, f_texcoord, 0));  
	vec4 color2 = max(textureLod(u_color2, f_texcoord, 0), textureLod(u_color3, f_texcoord, 0));  
	final_color0 = max(color1, color2);
}
