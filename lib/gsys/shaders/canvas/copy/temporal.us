//
//
//
#include <canvas/vert.us>
vert:
void main() { canvas_main(); }

frag:

uniform sampler2D u_color0; // current
uniform sampler2D u_color1; // prev
uniform float u_exposure0 = 1.0;
uniform float u_exposure1 = 1.0;

in vec2 f_texcoord;
layout (location = 0) out vec4 final_color0;

void main ()
{
	float mix_rate = min(u_exposure1 / (u_exposure0 + u_exposure1), 0.99);
	vec4 color0 = textureLod(u_color0, f_texcoord, 0);
	vec4 color1 = textureLod(u_color1, f_texcoord, 0);
	
	final_color0 = mix(color0, color1, mix_rate);
	//final_color0 = color0 * u_exposure0 + color1 * u_exposure1;
	

	
}




