//
//
//
vert:
out vec2 f_texcoord;
void canvas_main(float depth=0.0)
{
	const vec2 c_positions[4] = {
		vec2(-1, -1), vec2(+1, -1),
		vec2(-1, +1), vec2(+1, +1),
	};

	f_texcoord  = c_positions[gl_VertexID] * 0.5 + vec2(0.5, 0.5);
	gl_Position = vec4(c_positions[gl_VertexID], depth, 1); // triangle-srip
}


