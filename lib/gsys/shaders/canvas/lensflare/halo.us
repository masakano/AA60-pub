//
//
//
#ifndef def_use_halo
#define def_use_halo true
#endif

#ifndef def_use_dirt_texture
#define def_use_dirt_texture true
#endif

#include <canvas/vert.us>
vert:
void main() { canvas_main(); }

frag:

in  vec2 f_texcoord;
layout (location = 0) out vec4 final_color0;

uniform sampler2D u_color0; // low blurred texture
uniform sampler2D u_color1; // high blurred texture
uniform sampler2D u_dirt_texture;

uniform vec2	u_sun_pos_frag;
uniform vec3	u_distortion;
uniform float	u_dispersal;
uniform float	u_halo_width;
uniform bool	u_is_blur;
uniform bool	u_is_halo;

vec3 texture2DDistorted(sampler2D sampler, vec2 texcoord, vec2 offset)
{
	return vec3(
		texture2D(sampler, texcoord + offset * u_distortion.r).r,
		texture2D(sampler, texcoord + offset * u_distortion.g).g,
		texture2D(sampler, texcoord + offset * u_distortion.b).b
	);
}

void main()
{
	vec3 radial_blur = vec3(0.0);
	vec3 lansflare_halo = vec3(0.0);

	if (u_is_blur) {
		int radial_blur_samples = 128;
		vec2 texcoord = f_texcoord;
		vec2 radial_blur_vector = (u_sun_pos_frag - texcoord) / radial_blur_samples;
		
		for(int i = 0; i < radial_blur_samples; i++) {
			radial_blur += texture2D(u_color0, texcoord).rgb;
			texcoord += radial_blur_vector;
		}
		radial_blur /= radial_blur_samples;

		texcoord = 1.0 - f_texcoord;
		vec2 lansflare_vector = (vec2(0.5) - texcoord) * u_dispersal;
		vec2 lensflare_offset = vec2(0.0);

		if (def_use_halo) {
			for(int i = 0; i < 5; i++) {
				lansflare_halo += texture2DDistorted(u_color1, texcoord, lensflare_offset).rgb;
				lensflare_offset += lansflare_vector;
			}
			lansflare_halo += texture2DDistorted(
				u_color1, texcoord, normalize(lansflare_vector) * u_halo_width);
			lansflare_halo /= 6.0;
		}
	}

	vec3 color1 = texture2D(u_color1, f_texcoord).rgb;
	if (def_use_dirt_texture) {
		color1 += (radial_blur + lansflare_halo) * texture2D(u_dirt_texture, f_texcoord).rgb;
	}
	else {
		color1 += radial_blur + lansflare_halo;
	}
	final_color0 = vec4(color1, 1.0);
}
