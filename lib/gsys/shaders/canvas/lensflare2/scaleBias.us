//
//
//
#include <default/ub_connect.us>
#include <canvas/vert.us>

vert:
void main() { canvas_main(); }

frag:

in vec2 f_texcoord;
layout (location = 0) out vec4 final_color0;
uniform sampler2D u_input_texture;

void main()
{
	vec4 color0 = texture(u_input_texture, f_texcoord);
	final_color0 = max(vec4(0.0), color0 + ub_connect.sources[0].bias) * ub_connect.sources[0].gain;
}
