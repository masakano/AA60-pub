//
//
#include "cloudy_irradiance_common.us"
#include "ub_cloudy_irradiance.us"
#define ub ub_cloudy_irradiance

frag:

in vec2 f_texcoord;
layout(location = 0) out vec4 final_color0;

float turbulence(vec3 p, int octaves, float lacunarity, float gain)
{
	float amp = 0.5;
	float sum = 0;
	for (int i = 0; i < octaves; i++) {
		sum += abs(noise_snoise(p).x) * amp;
		p *= lacunarity;
		amp *= gain;
	}
	return sum;
}

vec2 cloud_map(vec3 p)
{
	float d = turbulence(
	        p / ub.granularity + ub.offset,
	        ub.octaves,
	        ub.lacunarity,
	        ub.gain);

	float c = smoothstep(ub.cloud_bottom, ub.cloud_top, p.y) * 0.5 + 0.5;  // darken base

	d = smoothstep(ub.density_min, ub.density_max, d);  // threshold density
	return vec2(c, d * ub.density_scale);
}

vec2 ray_march(vec3 rayorg, vec3 raydir, float stepsize)
{
	vec2 sum = vec2(0);
	vec3 p = rayorg;
	vec3 step = raydir * stepsize;

	// ray march front to back
	for (int i = 0; i < ub.steps; i++) {
		vec2 col = cloud_map(p);
		col.x *= col.y;  // pre-multiply alpha
		sum = sum + col * (1.0 - sum.y);
		p += step;
	}
	return sum;
}

float intersect_plane(vec3 n, float d, vec3 rayorg, vec3 raydir)
{
	return (-d - dot(rayorg, n)) / dot(raydir, n);
}

vec2 render_cloud(const vec3 rayorg, const vec3 raydir)
{
	float tnear = intersect_plane(vec3(0.0, -1.0, 0.0), ub.cloud_bottom, rayorg, raydir);
	float tfar = intersect_plane(vec3(0.0, -1.0, 0.0), ub.cloud_top, rayorg, raydir);
	float stepsize = (tfar - tnear) / ub.steps;

	vec2 c = vec2(0.0);
	if (tnear > 0 && raydir.y > 0.0) {
		c = ray_march(rayorg + tnear * raydir, raydir, stepsize);
	}
	return c;
}

void main()
{
	vec3 raydir = uv_to_raydir(f_texcoord);

	vec3 sky_color_raydir;
	{
		vec3 colorR;
		vec3 colorM;
		skydome_render_sky(raydir, ub.sky_cutoff_angle, colorR, colorM);
		sky_color_raydir = colorR + colorM;
	}
	
	vec3 sky_color_sundir;
	{
		vec3 colorR;
		vec3 colorM;
		skydome_render_sky(ub.sundir, ub.sky_cutoff_angle, colorR, colorM);
		sky_color_sundir = colorM * 0.25; // need parameteirize
	}
	
	vec3 cloud_rayorg = vec3(0); // temporary
	vec2 cloud_value = render_cloud(cloud_rayorg, raydir)
	                 * smoothstep(0.0, ub.cloud_fade_angle, raydir.y);
	vec3 sun_color = skydome_render_sun(ub.sundir, raydir);
	
	final_color0.rgb = sky_color_sundir * cloud_value.y + (sky_color_raydir + sun_color);
	//final_color0.rgb = sky_color_raydir;
	final_color0.a = 1;
	
}
