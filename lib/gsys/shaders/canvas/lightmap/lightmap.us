//
//
//
#include <decorator/material/material.us>
#include <canvas/vert.us>

vert:

void main()
{
	canvas_main(1.0);
}

frag:

layout (location = 0) out vec4 final_color0;

uniform sampler2D u_color0;
uniform sampler2D u_depth;

in vec2 f_texcoord;

vec3 get_raydir_view()
{
	vec2 position_screen = f_texcoord * 2.0 - 1.0;
	vec4 position_view = ub_lightmap.screenview * vec4(position_screen, 0, 1);
	return normalize(position_view.xyz);
}

void main()
{
	vec3 raydir_view = get_raydir_view();
	final_color0.rgb = texture_lightmap(raydir_view, 0.0, vec3(0));
	final_color0.a = 0;
}


