//
//
//
#include <painter/pbr/vert.us>
#include <painter/pbr/frag.us>
#include "ub_fur.us"

vert:
void main()
{
	pbr_main();
	gl_PointSize = 4.0;
}

geom:
layout(triangles) in;
layout(line_strip, max_vertices = 6) out;

uniform sampler2DArray u_rand_texture;

vec3 center_normal_view;
vec3 center_tangent_view;
vec3 center_binormal_view;
float center_radius;

void calculate_center_ntb()
{
	vec4 p0 = vertblock_in[0].position_view;
	vec4 p1 = vertblock_in[1].position_view;
	vec4 p2 = vertblock_in[2].position_view;

	vec3 dp1 = vec3(p1 - p0);
	vec3 dp2 = vec3(p2 - p0);

	center_radius = (length(p1 - p0) + length(p2 - p1) + length(p0 - p2)) / 3;

	center_normal_view = normalize(cross(dp1, dp2));
	center_tangent_view = normalize(cross(center_normal_view, dp2));
	center_binormal_view = normalize(cross(center_normal_view, center_tangent_view));
}


void emit_line(int index)
{
	vec3 position_view = vertblock_in[index].position_view.xyz;
	vec3 normal_view = vertblock_in[index].normal_view;
	vec2 texcoord = vertblock_in[index].texcoord.xy;
	vec4 jitter = texture(u_rand_texture, vec3(texcoord, index));

	vec2 position_jitter = jitter.zw * center_radius * ub_fur.position_jitter_scale;
	vec2 normal_jitter = jitter.xy * ub_fur.normal_jitter_scale;
	float height_jitter = length(jitter) * ub_fur.height_jitter_scale;

	position_view += center_tangent_view * position_jitter.x + center_binormal_view * position_jitter.y;
	normal_view += center_tangent_view * normal_jitter.x + center_binormal_view * normal_jitter.y;
	EMIT_VERTBLOCK(vertblock_out, vec4(texcoord, 0, 1), vec4(position_view, 1), normal_view);

	vec3 position_view1 = position_view + normalize(normal_view) * (1.0 + height_jitter) * ub_fur.height;

	gl_Position = ub_composition.viewscreen * vec4(position_view, 1);
	EmitVertex();

	gl_Position = ub_composition.viewscreen * vec4(position_view1, 1);
	EmitVertex();

	EndPrimitive();
}

void main()
{
	calculate_center_ntb();
	emit_line(0);
	emit_line(1);
	emit_line(2);
}	


frag:
layout (location = 0) out vec4 final_color0;

void main()
{
	final_color0 = pbr_main();
	//final_color0.rgb *= 8;
}
