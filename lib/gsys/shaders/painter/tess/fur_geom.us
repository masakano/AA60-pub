//
//
//
#pragma once
#include <decorator/tess/tess.us>

geom:

uniform sampler2D	u_rand_texture;
uniform vec4		u_fur_variance = vec4(1.0, 1.0, 0.1, 1.0); 
uniform float		u_fur_len      = 0.05;

mat4 geom_viewscreen();

#ifdef def_use_geom_viewscreen
mat4 geom_viewscreen()
{
	return ub_composition.viewscreen;
}
#endif

void fur_main()
{
	vec4 jitter = texture(u_rand_texture, vertblock_in[0].texcoord.xy) * u_fur_variance;
	vec4 jitter_exp = exp(jitter);

	vec4 p0 = vertblock_in[0].position_view;
	vec4 p1 = vertblock_in[1].position_view;
	vec4 p2 = vertblock_in[2].position_view;
	vec4 pc = (p0 + p1 + p2) / 3.0;

	vec4 t0 = vertblock_in[0].texcoord;
	vec4 t1 = vertblock_in[1].texcoord;
	vec4 t2 = vertblock_in[2].texcoord;
	vec4 tc = (t0 + t1 + t2) / 3.0;
	
	vec3 dp1 = vec3(p1 - p0);
	vec3 dp2 = vec3(p2 - p0);

	vec3 normal   = cross(dp1, dp2);
	vec3 tangent  = cross(normal, dp2);
	vec3 binormal = cross(normal, tangent);

	normal   = normalize(normal);
	tangent  = normalize(tangent);
	binormal = normalize(binormal);

	normal = normalize(normal + tangent * jitter.x +  binormal * jitter.y);
	if (normal.z < -0.2) return;
	vec4 pb = pc + vec4(normal * u_fur_len * jitter_exp.z, 0);

	EMIT_VERTBLOCK(vertblock_out, tc, pc, normal);

	gl_Position = geom_viewscreen() * pc;
	EmitVertex();

	gl_Position = geom_viewscreen() * pb;
	EmitVertex();

	EndPrimitive();
}
common: // pop back

