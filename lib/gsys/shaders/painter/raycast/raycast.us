//
//
//
#include <decorator/material/material.us>

vert:
in vec2 a_position;

void main()
{
	gl_Position = vec4(a_position, 1, 1);
}

frag:
struct Ray {
	vec3 p;
	vec3 n;
};

uniform sampler2D u_depth;
uniform sampler3D u_volume;
uniform sampler3D u_occlusion;
uniform sampler1D u_clut;

uniform mat4 u_viewvolume;
uniform mat4 u_fragview;

uniform float u_volume_scale;

layout (location = 0) out vec4 final_color0;

void aabb_intersect(const Ray ray, inout float t_min, inout float t_max)
{
	const vec3 p0 = vec3(-1);
	const vec3 p1 = vec3( 1);
	
	vec3 inv_n = vec3(1.0) / ray.n;
	vec3 tv0 = (p0 - ray.p) * inv_n;
	vec3 tv1 = (p1 - ray.p) * inv_n;
	
	vec3 tv_min = min(tv0, tv1);
	vec3 tv_max = max(tv0, tv1);
	
	t_min = max(max(tv_min.x, tv_min.y), max(tv_min.z, t_min));
	t_max = min(min(tv_max.x, tv_max.y), min(tv_max.z, t_max));
}

void main()
{
	const vec3 albedo = vec3(ub_material.albedo);
	const vec3 ambient = ub_material.ao * albedo;
	
	const vec3 texture_size = vec3(textureSize(u_volume, 0));
	const float t_step = 1.0 / max(max(texture_size.x, texture_size.y), texture_size.z);
	const float depth = texelFetch(u_depth, ivec2(gl_FragCoord.xy), 0).r;
	
	vec4 position_volume = (u_viewvolume * u_fragview) * vec4(gl_FragCoord.xy, depth, 1);
	position_volume.xyz /= position_volume.w;


	Ray ray;
	ray.p = u_viewvolume[3].xyz;

	vec3 raydir = position_volume.xyz - ray.p;
	ray.n = normalize(raydir);

	float t_min = 0;
	float t_max = length(raydir);
	
	aabb_intersect(ray, t_min, t_max);

	vec3 c = vec3(0);
	float d = 0.0;
	for (float t = t_min; t <= t_max; t += t_step) {
		vec3 p0 = ray.p + ray.n * t;
		vec3 tc0 = (p0 + 1.0) * 0.5;
		float d0 = texture(u_volume, tc0).r * u_volume_scale;

		if (def_use_clut == 1) {
			float t0 = texture(u_volume, tc0).g;
			vec3 c0 = texture(u_clut, t0).xyz;  // rgb only
			//c += c0 * d0;
			c += c0 * (1 - d * 0.75) * d0; // ad-hoc
		}
		else {
			float occlusion = texture(u_occlusion, tc0).r;
			vec3 c0 = ambient + albedo * occlusion;
			c += c0 * (1 - d) * d0;
		}
		
		d += (1 - d) * d0;
		if (d >= 1.0) break;
	}
	final_color0 = vec4(c, min(1.0, d));
	gl_FragDepth = depth;
}
