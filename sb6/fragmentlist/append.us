//
//
//
vert:

in vec4 a_position;
uniform mat4 u_modelscreen;

out VS_OUT
{
	vec4 pos;
	vec4 color;
} vs_out;

void main()
{
	vec4 p = u_modelscreen * a_position;

	gl_Position = p;
	vs_out.color = vec4(1.0);
	vs_out.pos = p / p.w;
}

frag:

// 2D image to store head pointers
layout (binding = 0, r32ui) coherent uniform uimage2D u_head_pointer;

// Shader storage buffer containing appended fragments
struct list_item
{
	vec4    color;
	float   depth;
	int     facing;
	uint    next;
	uint	pad;
};

layout (binding = 0, std430) buffer list_item_block
{
	list_item   item[];
};

// Atomic counter for filled size
layout (binding = 1) buffer a_atomic { uint ui; } fill_counter;

// Input from vertex shader
in VS_OUT
{
	vec4 pos;
	vec4 color;
} fs_in;

void main()
{
	ivec2 P = ivec2(gl_FragCoord.xy);
	uint index = atomicAdd(fill_counter.ui, 1);
	uint old_head = imageAtomicExchange(u_head_pointer, P, index);
    
	item[index].color = fs_in.color;
	item[index].depth = gl_FragCoord.z;
	item[index].facing = gl_FrontFacing ? 1 : 0;
	item[index].next = old_head;

}
