//
//
//
vert:

in vec4 a_position;
in vec3 a_normal;
in vec3 a_tangent;
in vec2 a_texcoord;

out VS_OUT
{
    vec3    ws_coords;
    vec3    normal;
    vec3    tangent;
    vec2    texcoord;
    flat uint    material_id;
} vs_out;

layout (std140) uniform ub_transform
{
    mat4        projection_matrix;
    mat4        view_matrix;
    mat4        model_matrix[256];
};

void main()
{
    mat4 u_modelview = view_matrix * model_matrix[gl_InstanceID];

    gl_Position = projection_matrix * u_modelview * a_position;
    vs_out.ws_coords = (model_matrix[gl_InstanceID] * a_position).xyz;
    vs_out.normal = mat3(model_matrix[gl_InstanceID]) * a_normal;
    vs_out.tangent = a_tangent;
    vs_out.texcoord = a_texcoord;
    vs_out.material_id = uint(gl_InstanceID);
}

frag:

layout (location = 0) out uvec4 color0;
layout (location = 1) out vec4 color1;


in VS_OUT
{
    vec3    ws_coords;
    vec3    normal;
    vec3    tangent;
    vec2    texcoord;
    flat uint    material_id;
} fs_in;

layout (binding = 0) uniform sampler2D u_albedomap;

void main()
{
    uvec4 outvec0 = uvec4(0);
    vec4 outvec1 = vec4(0);
    vec3 color = texture(u_albedomap, fs_in.texcoord).rgb;

    outvec0.x = packHalf2x16(color.xy);
    outvec0.y = packHalf2x16(vec2(color.z, fs_in.normal.x));
    outvec0.z = packHalf2x16(fs_in.normal.yz);
    outvec0.w = fs_in.material_id;

    outvec1.xyz = fs_in.ws_coords;
    outvec1.w = 30.0;

    color0 = outvec0;
    color1 = outvec1;

}
