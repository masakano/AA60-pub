//
//
//
vert:
//#version 420 core

uniform mat4 u_modelview;
uniform mat4 u_viewscreen;
uniform mat4 u_modelshadowtex;

in vec4 a_position;
in vec3 a_normal;

out VS_OUT
{
    vec4 shadow_coord;
    vec3 N;
    vec3 L;
    vec3 V;
} vs_out;

// Position of light
uniform vec3 u_light_position = vec3(100.0, 100.0, 100.0);

void main()
{
    // Calculate view-space coordinate
    vec4 P = u_modelview * a_position;

    // Calculate normal in view-space
    vs_out.N = mat3(u_modelview) * a_normal;

    // Calculate light vector
    vs_out.L = u_light_position - P.xyz;

    // Calculate view vector
    vs_out.V = -P.xyz;

    // Light-space coordinates
    vs_out.shadow_coord = u_modelshadowtex * a_position;

    // Calculate the clip-space a_position of each vertex
    gl_Position = u_viewscreen * P;
}

frag:
//#version 420 core

layout (location = 0) out vec4 color;

layout (binding = 0) uniform sampler2DShadow u_shadow_texture;

in VS_OUT
{
    vec4 shadow_coord;
    vec3 N;
    vec3 L;
    vec3 V;
} fs_in;

// Material properties
uniform vec3 diffuse_albedo = vec3(0.9, 0.8, 1.0);
uniform vec3 specular_albedo = vec3(0.7);
uniform float specular_power = 300.0;
uniform bool full_shading = true;

void main()
{
    // Normalize the incoming N, L and V vectors
    vec3 N = normalize(fs_in.N);
    vec3 L = normalize(fs_in.L);
    vec3 V = normalize(fs_in.V);

    // Calculate R locally
    vec3 R = reflect(-L, N);

    // Compute the diffuse and specular components for each fragment
    vec3 diffuse = max(dot(N, L), 0.0) * diffuse_albedo;
    vec3 specular = pow(max(dot(R, V), 0.0), specular_power) * specular_albedo;

    // Write final color to the framebuffer
    color = textureProj(u_shadow_texture, fs_in.shadow_coord) * mix(vec4(1.0), vec4(diffuse + specular, 1.0), bvec4(full_shading));
}
