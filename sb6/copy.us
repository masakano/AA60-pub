//
//
//
#include <canvas/vert.us>

vert:
void main() { canvas_main(); }

frag:

uniform float u_zoom;
uniform sampler2D u_color0;
in vec2 f_texcoord;
layout (location = 0) out vec4 final_color0;

void main ()
{
	vec2 texcoord = (f_texcoord - 0.5) / u_zoom + 0.5;
	vec4 color = textureLod(u_color0, texcoord, 0);
	final_color0 = color;
}




