//
//
//
vert:
//#version 420 core

uniform mat4 u_modelview;
uniform mat4 u_viewscreen;

in vec4 a_position;
in vec3 a_normal;
in vec2 a_texcoord;

out VS_OUT
{
    vec3 normal;
    vec3 view;
    vec2 tc;
} vs_out;

void main()
{
    vec4 pos_vs = u_modelview * a_position;

    vs_out.normal = mat3(u_modelview) * a_normal;
    vs_out.view = pos_vs.xyz;
    vs_out.tc = a_texcoord;

    gl_Position = u_viewscreen * pos_vs;
}

frag:
//#version 420 core

//layout (binding = 0) uniform sampler3D u_envmap_texture;
layout (binding = 0) uniform samplerCube u_envmap_texture;
layout (binding = 1) uniform sampler2D u_glossmap_texture;

in VS_OUT
{
    vec3 normal;
    vec3 view;
    vec2 tc;
} fs_in;

out vec4 color;

void main()
{
    // u will be our normalized view vector
    vec3 u = normalize(fs_in.view);

    // Reflect u about the plane defined by the normal at the fragment
    vec3 r = reflect(u, normalize(fs_in.normal));

    // Compute scale factor
    r.z += 1.0;
    float m = 0.5 * inversesqrt(dot(r, r));

    // Sample gloss factor from glossmap texture
    float gloss = texture(u_glossmap_texture, fs_in.tc * vec2(3.0, 1.0) * 2.0).r;

    // Sample from scaled and biased texture coordinate
    vec3 env_coord = vec3(r.xy * m + vec2(0.5), gloss);

    // Sample from two-level environment map
    color = texture(u_envmap_texture, env_coord);
}
