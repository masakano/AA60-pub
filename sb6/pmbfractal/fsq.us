//
//
//
vert:
out vec2 uv;

void main()
{
	vec2 pos = vec2(float(gl_VertexID & 2), float(gl_VertexID * 2 & 2));
	uv = pos * 0.5;
	gl_Position = vec4(pos - vec2(1.0), 0.0, 1.0);
}

frag:

layout (binding = 0) uniform sampler2D tex;
in vec2 uv;
layout (location = 0) out vec4 color;

void main()
{
	color = texture(tex, uv).xxxx;
}
