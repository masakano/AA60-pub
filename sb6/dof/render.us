//
//
//
vert:
//#version 420 core

uniform mat4 u_modelview;
uniform mat4 u_viewscreen;

in vec4 a_position;
in vec3 a_normal;

out VS_OUT
{
    vec3 N;
    vec3 L;
    vec3 V;
} vs_out;

// Position of light
uniform vec3 light_pos = vec3(100.0, 100.0, 100.0);

void main()
{
    // Calculate view-space coordinate
    vec4 P = u_modelview * a_position;

    // Calculate normal in view-space
    vs_out.N = mat3(u_modelview) * a_normal;

    // Calculate light vector
    vs_out.L = light_pos - P.xyz;

    // Calculate view vector
    vs_out.V = -P.xyz;

    // Calculate the clip-space position of each vertex
    gl_Position = u_viewscreen * P;
}

frag:
//#version 420 core

layout (location = 0) out vec4 color;

in VS_OUT
{
    vec3 N;
    vec3 L;
    vec3 V;
} fs_in;


uniform vec3 u_albedo;
uniform vec3 u_specular_albedo;
uniform float u_specular_power;
uniform bool u_full_shading;

void main()
{
    // Normalize the incoming N, L and V vectors
    vec3 N = normalize(fs_in.N);
    vec3 L = normalize(fs_in.L);
    vec3 V = normalize(fs_in.V);

    // Calculate R locally
    vec3 R = reflect(-L, N);

    // Compute the diffuse and specular components for each fragment
    vec3 diffuse = max(dot(N, L), 0.0) * u_albedo;
    vec3 specular = pow(max(dot(R, V), 0.0), u_specular_power) * u_specular_albedo;

    // Write final color to the framebuffer
    color = vec4(diffuse + specular, fs_in.V.z);
}
