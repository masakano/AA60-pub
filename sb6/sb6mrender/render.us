//
//
//
vert:

in vec4 a_position;
in vec3 a_normal;
in vec3 a_tangent;
in vec3 a_bitangent;
in vec2 a_texcoord;

out VS_OUT
{
    vec3 normal;
    vec3 tangent;
    vec3 bitangent;

    vec3 ws_pos;
    vec4 color;
    vec2 texcoord;
} vs_out;

uniform mat4 u_modelview;
uniform mat4 u_viewscreen;

void main()
{
    gl_Position = u_viewscreen * u_modelview * a_position;
    vs_out.normal = mat3(u_modelview) * a_normal;
    vs_out.tangent = mat3(u_modelview) * a_tangent;
    vs_out.bitangent = mat3(u_modelview) * a_bitangent;

    vs_out.ws_pos = (u_modelview * a_position).xyz;
    vs_out.color = a_position * 2.0 + vec4(0.5, 0.5, 0.5, 0.0);
    vs_out.texcoord = a_texcoord;
}

frag:
//#version 420 core

out vec4 color;

layout (binding = 0) uniform sampler2D u_albedomap;
layout (binding = 1) uniform sampler2D u_normalmap;

in VS_OUT
{
    vec3 normal;
    vec3 tangent;
    vec3 bitangent;

    vec3 ws_pos;
    vec4 color;
    vec2 texcoord;
} fs_in;

uniform vec3 light_pos = vec3(0.0, 3.0, 10.0);

void main()
{
    vec3 L = normalize(light_pos - fs_in.ws_pos);

    float x = dot(L, normalize(fs_in.tangent));
    float y = dot(L, normalize(fs_in.bitangent));
    float z = dot(L, normalize(fs_in.normal));

    vec3 V = normalize(vec3(x, y, z));
    vec3 bump = texture(u_normalmap, fs_in.texcoord).rgb;
    bump = normalize(bump * 2.0 - vec3(1.0));

    float diffuse = max( dot(L, bump), 0.0 );
    float specular = pow(dot(reflect(-L, bump), V), 6.0) * 0.3;

    // color = texture(u_albedomap, fs_in.texcoord);
    // color = vec4(x, y, z, 0.0);
    // color = vec4(bump, 1.0);
    // color = vec4(L, 1.0);
    // color = vec4( fs_in.ws_pos, 1.0 );

    color = vec4(abs(specular)) + abs(diffuse) * texture(u_albedomap, fs_in.texcoord);
}
