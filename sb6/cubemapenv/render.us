//
//
//
vert:

uniform mat4 u_modelview;
uniform mat4 u_viewscreen;

in vec4 a_position;
in vec3 a_normal;

out VS_OUT
{
	vec3 normal;
	vec3 view;
} vs_out;

void main()
{
	vec4 pos_vs = u_modelview * a_position;

	vs_out.normal = mat3(u_modelview) * a_normal;
	vs_out.view = pos_vs.xyz;

	gl_Position = u_viewscreen * pos_vs;
}

frag:

uniform samplerCube u_cubemap_texture;

in VS_OUT
{
	vec3 normal;
	vec3 view;
} fs_in;

out vec4 color;

void main()
{
	vec3 r = reflect(fs_in.view, normalize(fs_in.normal));
	color = texture(u_cubemap_texture, r) * vec4(0.95, 0.80, 0.45, 1.0);
}
