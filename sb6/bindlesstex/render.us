//
//
//
vert:

// Per-vertex inputs
in vec4 a_position;
in vec3 a_normal;
in vec2 a_texcoord;

// Matrices we'll need
layout (std140, binding = 0) uniform MATRIX_BLOCK
{
	mat4 model_matrix[386]; // 0 view_matrix, 1:u_viewscreen
};

// Inputs from vertex shader
out VS_OUT
{
	vec3 N;
	vec3 L;
	vec3 V;
	vec2 tc;
	flat uint instance_index;
} vs_out;

// Position of light
const vec3 light_pos = vec3(100.0, 100.0, 100.0);

void main()
{
#if 1
	mat4 view_matrix = model_matrix[0];
	mat4 u_viewscreen = model_matrix[1];
#endif

	mat4 u_modelview = view_matrix * model_matrix[gl_InstanceID + 2];
	// mat4 u_viewscreen = u_viewscreen;

	// Calculate view-space coordinate
	vec4 P = u_modelview * a_position;

	// Calculate normal in view-space
	vs_out.N = mat3(u_modelview) * a_normal;

	// Calculate light vector
	vs_out.L = light_pos - P.xyz;

	// Calculate view vector
	vs_out.V = -P.xyz;

	// Pass texture coordinate through
	vs_out.tc = a_texcoord * vec2(5.0, 1.0);

	// Pass instance ID through
	vs_out.instance_index = gl_InstanceID;

	// Calculate the clip-space position of each vertex
	gl_Position = u_viewscreen * P;
}

frag:

// Output
layout (location = 0) out vec4 color;

// Input from vertex shader
in VS_OUT
{
	vec3 N;
	vec3 L;
	vec3 V;
	vec2 tc;
	flat uint instance_index;
} fs_in;

// Material properties
const vec3 ambient = vec3(0.1, 0.1, 0.1);
const vec3 diffuse_albedo = vec3(0.9, 0.9, 0.9);
const vec3 specular_albedo = vec3(0.7);
const float specular_power = 300.0;

// Texture block
layout (binding = 1, std140) uniform TEXTURE_BLOCK
{
	sampler2D      tex[384];
};

void main()
{
	// Normalize the incoming N, L and V vectors
	vec3 N = normalize(fs_in.N);
	vec3 L = normalize(fs_in.L);
	vec3 V = normalize(fs_in.V);
	vec3 H = normalize(L + V);

	// Compute the diffuse and specular components for each fragment
	vec3 diffuse = max(dot(N, L), 0.0) * diffuse_albedo;
	// This is where we reference the bindless texture
	diffuse *= texture(tex[fs_in.instance_index], fs_in.tc * 2.0).rgb;
	vec3 specular = pow(max(dot(N, H), 0.0), specular_power) * specular_albedo;

	// Write final color to the framebuffer
	color = vec4(ambient + diffuse + specular, 1.0);
}
