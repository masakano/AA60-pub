//
//
//
vert:
//#version 410 core

uniform mat4 u_modelview;
uniform mat4 u_viewscreen;

in vec4 a_position;
in vec3 a_normal;

out VS_OUT
{
    vec3 normal;
    vec3 view;
} vs_out;

void main()
{
    vec4 pos_vs = u_modelview * a_position;

    vs_out.normal = mat3(u_modelview) * a_normal;
    vs_out.view = pos_vs.xyz;

    gl_Position = u_viewscreen * pos_vs;
}

frag:
//#version 410 core

uniform sampler2D u_envmap_texture;

in VS_OUT
{
    vec3 normal;
    vec3 view;
} fs_in;

out vec4 color;

void main()
{
    // u will be our normalized view vector
    vec3 u = normalize(fs_in.view);

    // Reflect u about the plane defined by the normal at the fragment
    vec3 r = reflect(u, normalize(fs_in.normal));

    // Compute scale factor
    r.z += 1.0;
    float m = 0.5 * inversesqrt(dot(r, r));

    // Sample from scaled and biased texture coordinate
    color = texture(u_envmap_texture, r.xy * m + vec2(0.5));
}
