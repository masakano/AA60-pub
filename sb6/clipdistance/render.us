//
//
//
vert:

// Per-vertex inputs
in vec4 a_position;
in vec3 a_normal;

uniform mat4 u_modelview;
uniform mat4 u_viewscreen;

// Inputs from vertex shader
out VS_OUT
{
    vec3 N;
    vec3 L;
    vec3 V;
} vs_out;

// Position of light
uniform vec3 u_light_position = vec3(100.0, 100.0, 100.0);

// Clip plane
uniform vec4 u_clip_plane = vec4(1.0, 1.0, 0.0, 0.85);
uniform vec4 u_clip_sphere = vec4(0.0, 0.0, 0.0, 4.0);

void main()
{
    // Calculate view-space coordinate
    vec4 P = u_modelview * a_position;

    // Calculate normal in view-space
    vs_out.N = mat3(u_modelview) * a_normal;

    // Calculate light vector
    vs_out.L = u_light_position - P.xyz;

    // Calculate view vector
    vs_out.V = -P.xyz;

    // Write clip distances
    gl_ClipDistance[0] = dot(a_position, u_clip_plane);
    gl_ClipDistance[1] = length(a_position.xyz / a_position.w - u_clip_sphere.xyz) - u_clip_sphere.w;

    // Calculate the clip-space position of each vertex
    gl_Position = u_viewscreen * P;
}

frag:

// Output
layout (location = 0) out vec4 color;

// Input from vertex shader
in VS_OUT
{
    vec3 N;
    vec3 L;
    vec3 V;
} fs_in;

// Material properties
uniform vec3 diffuse_albedo = vec3(0.3, 0.5, 0.2);
uniform vec3 specular_albedo = vec3(0.7);
uniform float specular_power = 128.0;
uniform vec3 rim_color = vec3(0.1, 0.2, 0.2);
uniform float rim_power = 5.0;

vec3 calculate_rim(vec3 N, vec3 V)
{
    float f = 1.0 - dot(N, V);

    f = smoothstep(0.0, 1.0, f);
    f = pow(f, rim_power);

    return f * rim_color;
}

void main()
{
    // Normalize the incoming N, L and V vectors
    vec3 N = normalize(fs_in.N);
    vec3 L = normalize(fs_in.L);
    vec3 V = normalize(fs_in.V);

    // Calculate R locally
    vec3 R = reflect(-L, N);

    // Compute the diffuse and specular components for each fragment
    vec3 diffuse = max(dot(N, L), 0.0) * diffuse_albedo;
    vec3 specular = pow(max(dot(R, V), 0.0), specular_power) * specular_albedo;
    vec3 rim = calculate_rim(N, V);

    // Write final color to the framebuffer
    color = vec4(diffuse + specular + rim, 1.0);
}
