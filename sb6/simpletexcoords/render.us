//
//
//
vert:
//#version 420 core

uniform mat4 u_modelview;
uniform mat4 u_viewscreen;

in vec4 a_position;
in vec2 a_texcoord;

out VS_OUT
{
    vec2 tc;
} vs_out;

void main()
{
    vec4 pos_vs = u_modelview * a_position;

    vs_out.tc = a_texcoord;

    gl_Position = u_viewscreen * pos_vs;
}

frag:

layout (binding = 0) uniform sampler2D u_texture;

in VS_OUT
{
    vec2 tc;
} fs_in;

out vec4 color;

void main()
{
    color = texture(u_texture, fs_in.tc * vec2(3.0, 1.0));
}
