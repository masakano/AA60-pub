//
//
//
vert:
//#version 420 core

void main()
{
    const vec4 vertices[] = vec4[](
	    vec4(-1.0, -1.0, 0.5, 1.0),
	    vec4( 1.0, -1.0, 0.5, 1.0),
	    vec4(-1.0,  1.0, 0.5, 1.0),
	    vec4( 1.0,  1.0, 0.5, 1.0));

    gl_Position = vertices[gl_VertexID];
}
frag:

layout (binding = 0) uniform sampler2D u_hdr_image;
layout (binding = 1) uniform sampler2D u_bloom_image;

uniform float u_exposure;
uniform float u_bloom_factor;
uniform float u_scene_factor;

out vec4 color;

void main()
{
    vec4 c = vec4(0.0);

    c += texelFetch(u_hdr_image, ivec2(gl_FragCoord.xy), 0) * u_scene_factor;
    c += texelFetch(u_bloom_image, ivec2(gl_FragCoord.xy), 0) * u_bloom_factor;

    c.rgb = vec3(1.0) - exp(-c.rgb * u_exposure);
    color = c;
}
