//
//
//
vert:

out vec2 f_texcoord;
void main()
{
	const vec2 c_positions[4] = {
		vec2(-1, -1), vec2(+1, -1),
		vec2(-1, +1), vec2(+1, +1),
	};

	f_texcoord  = c_positions[gl_VertexID] * 0.5 + vec2(0.5, 0.5);
	gl_Position = vec4(c_positions[gl_VertexID], 0.0, 1); // triangle-srip
}
                
frag:

uniform float u_zoom;
uniform sampler2D u_color0;
in vec2 f_texcoord;
layout (location = 0) out vec4 final_color0;

void main ()
{
	vec2 texcoord = (f_texcoord - 0.5) / u_zoom + 0.5;
	vec4 color = textureLod(u_color0, texcoord, 0);
	final_color0 = color;
}




