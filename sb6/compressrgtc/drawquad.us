//
//
//
vert:

out vec2 uv;

void main()
{
	vec2 pos[] = vec2[](
		vec2(-1.0, -1.0),
		vec2( 1.0, -1.0),
		vec2(-1.0,  1.0),
		vec2( 1.0,  1.0));

	gl_Position = vec4(pos[gl_VertexID], 0.0, 1.0);
	uv = pos[gl_VertexID] * vec2(0.5, 0.5) + vec2(0.5);
}
frag:

uniform sampler2D tex;
out vec4 color;

in vec2 uv;
void main()
{
	color = texture(tex, uv).xxxx;
	//color = texelFetch(tex, ivec2(gl_FragCoord.xy), 0).xxxx;
}
