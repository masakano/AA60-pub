//
//
//
vert:
//#version 410 core

uniform mat4 u_modelscreen;
uniform int u_vid_offset;

out VS_OUT
{
    vec4 color;
} vs_out;

void main()
{
    const vec4 vertices[] = vec4[](vec4(-0.5, -0.5, 0.0, 1.0),
                                   vec4( 0.5, -0.5, 0.0, 1.0),
                                   vec4( 0.5,  0.5, 0.0, 1.0),
                                   vec4(-0.5,  0.5, 0.0, 1.0));

    const vec4 colors[] = vec4[](vec4(0.0, 0.0, 0.0, 1.0),
                                 vec4(0.0, 0.0, 0.0, 1.0),
                                 vec4(0.0, 0.0, 0.0, 1.0),
                                 vec4(1.0, 1.0, 1.0, 1.0));

    gl_Position = u_modelscreen * vertices[(gl_VertexID + u_vid_offset) % 4];
    vs_out.color = colors[(gl_VertexID + u_vid_offset) % 4];
}

frag:
//#version 410 core

in VS_OUT
{
    vec4 color;
} fs_in;

out vec4 color;

void main()
{
    color = fs_in.color;
}
