//
//
//
vert:

in vec4 a_position;
in vec3 a_normal;

struct Constant
{
	mat4 modelworld;
	mat4 worldview;
	mat4 viewscreen;
};	

/*layout (std140)*/ uniform UB_CONSTANT
{
	Constant c[64];
};

out VS_OUT
{
	smooth vec3 N;
	smooth vec3 L;
	smooth vec3 V;
	flat int ID;
} vs_out;

// Position of light
uniform vec3 light_pos = vec3(100.0, 100.0, 100.0);

void main()
{
	int id = gl_InstanceID;
	
	// Calculate view-space coordinate
	vec4 P = c[id].modelworld * a_position;

	// Calculate normal in view-space
	vs_out.N = mat3(c[id].modelworld) * a_normal;

	// Calculate light vector
	vs_out.L = light_pos - P.xyz;

	// Calculate view vector
	vs_out.V = -P.xyz;
	
	// material ID
	vs_out.ID = id;

	// Calculate the clip-space position of each vertex
	gl_Position = c[id].viewscreen * P;
}

frag:

layout (location = 0) out vec4 color;

in VS_OUT
{
	smooth vec3 N;
	smooth vec3 L;
	smooth vec3 V;
	flat int ID;
} fs_in;

struct Material
{
	vec4 diffuse_albedo;
	vec4 specular_albedo; // w: power
};

/*layout (std140)*/ uniform UB_MATERIAL
{
	Material m[64];
};

void main()
{
	// Normalize the incoming N, L and V vectors
	vec3 N = normalize(fs_in.N);
	vec3 L = normalize(fs_in.L);
	vec3 V = normalize(fs_in.V);
	vec3 H = normalize(L + V);

	// Compute the diffuse and specular components for each fragment
	int id = fs_in.ID;

	vec4 diffuse_albedo  = m[fs_in.ID].diffuse_albedo;
	vec4 specular_albedo = m[fs_in.ID].specular_albedo;
	
	vec3 diffuse = max(dot(N, L), 0.0) * diffuse_albedo.rgb;
	vec3 specular = pow(max(dot(N, H), 0.0), specular_albedo.a) * specular_albedo.rgb;

	// Write final color to the framebuffer
	color = vec4(diffuse + specular, 1.0);
}
