//
//
//
vert:

out vec3 uv;

layout (location = 0) uniform mat3 u_uv_transform;
layout (location = 1) uniform mat4 u_modelscreen;

void main()
{
    const vec2 pos[] = vec2[](vec2(-1.0, -1.0),
                              vec2(1.0, -1.0),
                              vec2(-1.0, 1.0),
                              vec2(1.0, 1.0));

    vec3 uv3 = u_uv_transform * vec3( (pos[gl_VertexID] + vec2(1.0, 1.0)) * vec2(0.5, -0.5), 1.0);
    uv.xy = uv3.xy / uv3.z;
    uv.z = float(gl_InstanceID);
    gl_Position = u_modelscreen * vec4(pos[gl_VertexID] + vec2(gl_InstanceID * 2, 0.0), 0.0, 1.0);
}

frag:

layout (location = 0) out vec4 color;
layout (binding = 0) uniform sampler2DArray u_texture;

// in vec2 uv;
in vec3 uv;

void main()
{
    const vec4 c1 = vec4(0.1, 0.1, 0.2, 1.0);
    const vec4 c2 = vec4(0.8, 0.9, 1.0, 1.0);
    float val = texture(u_texture, vec3(uv.xyz)).x;

    color = mix(c1, c2, smoothstep(0.52, 0.48, val));
}
