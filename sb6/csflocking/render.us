//
//
//
vert:

in vec3 a_position;
in vec3 a_normal;

in vec3 a_bird_position;
in vec3 a_bird_velocity;

out VS_OUT
{
	flat vec3 color;
} vs_out;

uniform mat4 u_modelscreen;

mat4 make_lookat(vec3 forward, vec3 up)
{
	vec3 side = cross(forward, up);
	vec3 u_frame = cross(side, forward);

	return mat4(vec4(side, 0.0),
		    vec4(u_frame, 0.0),
		    vec4(forward, 0.0),
		    vec4(0.0, 0.0, 0.0, 1.0));
}

vec3 choose_color(float f)
{
	float R = sin(f * 6.2831853);
	float G = sin((f + 0.3333) * 6.2831853);
	float B = sin((f + 0.6666) * 6.2831853);

	return vec3(R, G, B) * 0.25 + vec3(0.75);
}

void main()
{
	mat4 lookat = make_lookat(normalize(a_bird_velocity), vec3(0.0, 1.0, 0.0));
	vec4 obj_coord = lookat * vec4(a_position.xyz, 1.0);
	gl_Position = u_modelscreen * (obj_coord + vec4(a_bird_position, 0.0));

	vec3 N = mat3(lookat) * a_normal;
	vec3 C = choose_color(fract(float(gl_InstanceID / float(1237.0))));

	vs_out.color = mix(C * 0.2, C, smoothstep(0.0, 0.8, abs(N).z));
}

frag:

layout (location = 0) out vec4 color;

in VS_OUT
{
	flat vec3 color;
} fs_in;

void main()
{
	color = vec4(fs_in.color.rgb, 1.0);
}
