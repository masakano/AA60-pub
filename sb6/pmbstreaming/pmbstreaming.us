//
//
//
vert:

// Per-vertex inputs
in vec4 a_position;
in vec3 a_normal;
in vec2 a_texcoord;
in int a_draw_id;

struct MATRICES
{
	mat4 modelview;
	mat4 projection;
};

// Matrices we'll need
layout (std140) uniform constants
{
	//MATRICES matrices[16];
	MATRICES matrices[def_count];
};

// Inputs from vertex shader
out VS_OUT
{
	vec3 N;
	vec3 L;
	vec3 V;
	vec2 tc;
} vs_out;

// Position of light
const vec3 light_pos = vec3(100.0, 100.0, 100.0);

void main()
{
	mat4 u_modelview = matrices[a_draw_id].modelview;
	mat4 u_viewscreen = matrices[a_draw_id].projection;

	// Calculate view-space coordinate
	vec4 P = u_modelview * a_position;

	// Calculate normal in view-space
	vs_out.N = mat3(u_modelview) * a_normal;

	// Calculate light vector
	vs_out.L = light_pos - P.xyz;

	// Calculate view vector
	vs_out.V = -P.xyz;

	// Pass texture coordinate through
	vs_out.tc = a_texcoord * vec2(5.0, 1.0);

	// Calculate the clip-space position of each vertex
	gl_Position = u_viewscreen * P;
}

//#version 410 core
frag:

// Output
layout (location = 0) out vec4 color;

// Texture
layout (binding = 0) uniform sampler2D tex;

// Input from vertex shader
in VS_OUT
{
	vec3 N;
	vec3 L;
	vec3 V;
	vec2 tc;
} fs_in;

// Material properties
const vec3 diffuse_albedo = vec3(0.5, 0.5, 0.9);
const vec3 specular_albedo = vec3(0.7);
const float specular_power = 300.0;

void main()
{
	// Normalize the incoming N, L and V vectors
	vec3 N = normalize(fs_in.N);
	vec3 L = normalize(fs_in.L);
	vec3 V = normalize(fs_in.V);
	vec3 H = normalize(L + V);

	// Compute the diffuse and specular components for each fragment
	vec3 diffuse = max(dot(N, L), 0.0) * diffuse_albedo;
	vec3 specular = pow(max(dot(N, H), 0.0), specular_power) * specular_albedo;

	// Write final color to the framebuffer
	float factor = texture(tex, fs_in.tc).x;
	vec4 lit = vec4(mix(diffuse, diffuse.yzx, factor)+ specular, 1.0);
	color = lit;
}
