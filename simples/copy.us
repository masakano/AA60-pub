//
//
//
vert:
out vec2 f_texcoord;
void main()
{
	const vec2 positions[4] = {
		vec2(-1, -1), vec2(+1, -1),
		vec2(-1, +1), vec2(+1, +1),
	};
	f_texcoord  = positions[gl_VertexID] * 0.5 + vec2(0.5, 0.5);
	gl_Position = vec4(positions[gl_VertexID], 0, 1); // triangle-srip
}

frag:
uniform sampler2D u_color0;
in  vec2 f_texcoord;
layout (location = 0) out vec4 final_color0;

void main ()
{
	final_color0 = textureLod(u_color0, f_texcoord, 0);
}




